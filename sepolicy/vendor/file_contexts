# Fingerprint
/data/system/users/0/fpdata(/.*)?                               u:object_r:fingerprintd_data_file:s0

# /asusfw 掛載點（BOARD_ROOT_EXTRA_FOLDERS）：22.2 的 root 在 system.img 裡，每個路徑打包時都要有標記
# （16.0 的 root 在 ramdisk，不用）。掛上去之後由 fstab 的 context= 蓋掉，比照 /vendor/firmware_mnt
/asusfw                                                         u:object_r:asusfw_file:s0
/factory                                                        u:object_r:factory_file:s0
# BOARD_ROOT_EXTRA_SYMLINKS 的兩條（/dsp、/persist 上游已有標記）：root 的 symlink 照 AOSP 慣例標 rootfs
# （domain.te 給所有網域 rootfs:lnk_file read，跟著走到 /vendor/firmware_mnt 等目標）
/firmware                                                       u:object_r:rootfs:s0
/bt_firmware                                                    u:object_r:rootfs:s0

# Vulkan 驅動的 symlink（Android.bp：非 Treble 的 default namespace 不找 lib*/hw/）。App 經由它載入驅動，
# 標成跟 hw/ 裡的實體檔一樣的 same_process_hal_file（寫死路徑，避免被開頭是正規式的通用規則蓋掉）
/vendor/lib64/vulkan\.msm8998\.so                               u:object_r:same_process_hal_file:s0
/vendor/lib/vulkan\.msm8998\.so                                 u:object_r:same_process_hal_file:s0
/system/vendor/lib64/vulkan\.msm8998\.so                        u:object_r:same_process_hal_file:s0
/system/vendor/lib/vulkan\.msm8998\.so                          u:object_r:same_process_hal_file:s0

# HALs
# GNSS：AOSP 的 gnss@1.0-service 當宿主、載 ASUS 的 gnss@1.0-impl-qti（QTI 定位堆疊，透過 /data/vendor/location
# 的 socket 跟 loc_launcher / xtra-daemon 講話）。AOSP 標成 hal_gnss_default，缺 qcom 只給 hal_gnss_qti 的
# location_data_file:dir -> enforcing 下 GPS 不能用（2026-09-26 實測）。標成 qcom 的 hal_gnss_qti
# ⚠ 不能寫 /(vendor|system/vendor)/...：file_contexts 是「最後符合的那條」生效，fc_sort 依開頭固定字串的長度
#   排序，那樣寫的固定字串只有 "/"，會排在 AOSP 的 gnss@[0-9]\.[0-9]-service（hal_gnss_default_exec）前面而被蓋掉
/vendor/bin/hw/android\.hardware\.gnss@1\.0-service                                              u:object_r:hal_gnss_qti_exec:s0
/system/vendor/bin/hw/android\.hardware\.gnss@1\.0-service                                       u:object_r:hal_gnss_qti_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.1-service-custom    u:object_r:hal_fingerprint_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service\.oneplus-libperfmgr              u:object_r:hal_power_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.vibrator-service\.z01g                         u:object_r:hal_vibrator_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.livedisplay@2\.0-service\.oneplus_msm8998        u:object_r:hal_livedisplay_oneplus_msm8998_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.oneplus\.camera\.CameraHIDL@1\.0-service                  u:object_r:hal_cameraHIDL_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.oneplus\.hardware\.drmkey@1\.0-service                    u:object_r:hal_drm_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.oneplus\.hardware\.ifaa@2\.0-service                      u:object_r:hal_ifaa_default_exec:s0

