type dash_device, dev_type;
type fingerprint_device, dev_type;

# ASUS 的裝置節點（22.2 permissive 實測全落在通用的 `device`；16.0 sepolicy/vendor/device.te）
type goodix_fp_device, dev_type;         # /dev/goodix_fp（Goodix 指紋）
type asus_rgb_sensor_device, dev_type;   # /dev/asusRgbSensor、/dev/asusFRGBSensor（色溫感測器，相機用）
type asus_preisp_device, dev_type;       # /dev/rk_preisp（Rockchip RK1608 前置 ISP，望遠鏡頭）
type asus_laser_device, dev_type;        # /dev/LaserSensor（雷射對焦）
